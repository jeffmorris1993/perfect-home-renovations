# Resend API key — https://resend.com/api-keys. Leave unset in dev to run the
# estimate form in log-only mode (no email sent, submission logged to console).
RESEND_API_KEY=

# Where estimate requests are delivered. Until a domain is verified with
# Resend, the onboarding@resend.dev sender can only deliver to the Resend
# account owner's own email address.
ESTIMATE_TO_EMAIL=morrisjeffjr1993@gmail.com
ESTIMATE_FROM_EMAIL="Perfect Home Renovation <onboarding@resend.dev>"

# Canonical site URL used for metadata/sitemap (set to the real domain later).
NEXT_PUBLIC_SITE_URL=

# Google Places API (New) — homepage reviews, refreshed weekly via ISR. Leave
# unset to show the hardcoded testimonials instead. The key must have
# "Places API (New)" enabled and be restricted to that API.
GOOGLE_PLACES_API_KEY=
# The business's Google Place ID (public identifier for the GBP listing).
GOOGLE_PLACE_ID=ChIJHafWH7TPjyYRmGU0foA85jM
