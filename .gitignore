# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# photo originals (never committed; processed via npm run photos)
/wetransfer_*/
.idea/

# allow the env template (no secret values) while keeping real env files ignored
!.env.example

# raw hero video masters (never committed; renditions built via npm run video)
/Create_one_seamless_cinematic.mp4
/hero-source.mp4
